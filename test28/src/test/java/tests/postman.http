pm.test("Full response body match", function() {
    // Получаем актуальный ответ
    const actualResponse = pm.response.json();

    // Задаем ОЖИДАЕМЫЙ ответ (все поля!)
    const expectedResponse = {
        "args": {},
        "data": "{\n    \"test\": \"value\"\n}",
        "files": {},
        "form": {},
        "headers": {
            "host": "postman-echo.com",
            "x-request-start": actualResponse.headers["x-request-start"], // Динамическое поле
            "connection": "close",
            "content-length": "23",
            "x-forwarded-proto": "https",
            "x-forwarded-port": "443",
            "x-amzn-trace-id": actualResponse.headers["x-amzn-trace-id"], // Динамическое поле
            "content-type": "text/plain",
            "user-agent": "PostmanRuntime/7.43.3",
            "accept": "*/*",
            "cache-control": "no-cache",
            "postman-token": actualResponse.headers["postman-token"], // Динамическое поле
            "accept-encoding": "gzip, deflate, br",
            "cookie": actualResponse.headers["cookie"] // Динамическое поле
        },
        "json": null,
        "url": "https://postman-echo.com/post"
    };

    // Глубокое сравнение
    pm.expect(actualResponse).to.deep.eql(expectedResponse);
});


