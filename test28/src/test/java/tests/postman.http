// 1. Проверка кода ответа
pm.test("Status code is 200", function() {
    pm.response.to.have.status(200);
});

// 2. Полная проверка тела ответа с динамическими полями
pm.test("Complete response validation", function() {
    const response = pm.response.json();

    // Ожидаемая структура (статическая часть)
    const expected = {
        args: {},
        data: "This is expected to be sent back as part of response body.",
        files: {},
        form: {},
        headers: {
            host: "postman-echo.com",
            connection: "close",
            "content-length": "58",
            "x-forwarded-proto": "https",
            "x-forwarded-port": "443",
            "content-type": "text/plain",
            "user-agent": "PostmanRuntime/7.43.3",
            accept: "*/*",
            "cache-control": "no-cache",
            "accept-encoding": "gzip, deflate, br"
        },
        json: null,
        url: "https://postman-echo.com/patch"
    };

    // Динамические поля (копируем из ответа)
    expected.headers["x-request-start"] = response.headers["x-request-start"];
    expected.headers["x-amzn-trace-id"] = response.headers["x-amzn-trace-id"];
    expected.headers["postman-token"] = response.headers["postman-token"];
    expected.headers["cookie"] = response.headers["cookie"];

    // Глубокое сравнение
    pm.expect(response).to.deep.eql(expected);
});


