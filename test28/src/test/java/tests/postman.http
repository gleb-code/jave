// 3. Дополнительные проверки для DELETE-запроса
pm.test("DELETE-specific checks", function() {
    const res = pm.response.json();

    // Проверка, что данные не были модифицированы
    pm.expect(res.data).to.equal("This is expected to be sent back as part of response body.");

    // Проверка отсутствия возвращаемых данных в json
    pm.expect(res.json).to.be.null;

    // Проверка URL
    pm.expect(res.url).to.include("delete");
});

// 4. Проверка производительности
pm.test("Response time is acceptable", function() {
    pm.expect(pm.response.responseTime).to.be.below(500); // <500ms
});