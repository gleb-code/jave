GET /get?foo1=bar1&foo2=bar2 HTTP/1.1
Host: postman-echo.com



// 1. Проверка кода ответа
pm.test("Status code is 200", function() {
    pm.response.to.have.status(200);
});

// 2. Полная проверка тела ответа
pm.test("Exact response body match", function() {
    // Ожидаемая структура ответа
    const expectedResponse = {
        args: {
            foo1: "bar1",
            foo2: "bar2"
        },
        headers: {
            host: "postman-echo.com",
            "x-request-start": pm.response.json().headers["x-request-start"], // Динамическое поле
            connection: "close",
            "x-forwarded-proto": "https",
            "x-forwarded-port": "443",
            "x-amzn-trace-id": pm.response.json().headers["x-amzn-trace-id"], // Динамическое поле
            "user-agent": "PostmanRuntime/7.43.3",
            accept: "*/*",
            "cache-control": "no-cache",
            "postman-token": pm.response.json().headers["postman-token"], // Динамическое поле
            cookie: pm.response.json().headers["cookie"] // Динамическое поле
        },
        url: "https://postman-echo.com/get?foo1=bar1&foo2=bar2"
    };

    // Глубокое сравнение
    pm.expect(pm.response.json()).to.deep.eql(expectedResponse);
});


// Проверка кода статуса
pm.test("Status code is 200", function() {
    pm.response.to.have.status(200);
});

// Проверка наличия всех ожидаемых полей в ответе
pm.test("Response has correct structure", function() {
    const response = pm.response.json();
    pm.expect(response).to.be.an('object').that.has.all.keys(
        'args', 'data', 'files', 'form', 'headers', 'json', 'url'
    );
});
pm.test("Data field contains correct JSON", function() {
    const response = pm.response.json();

    // Проверяем, что data является строкой
    pm.expect(response.data).to.be.a('string');

    // Парсим и проверяем содержимое
    const parsedData = JSON.parse(response.data);
    pm.expect(parsedData).to.deep.equal({
        test: "value"
    });

    // Альтернативно - сравнение со отправленными данными
    const requestBody = JSON.parse(pm.request.body.raw);
    pm.expect(parsedData).to.deep.equal(requestBody);
});
